{
  "name": "v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "build-lock vite build && cp src/base.css dist/base.css && pnpm run build:components",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:components": "build-lock vite build --config vite.components.config.js",
    "lint": "eslint src/ scripts/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.9.1",
    "jsdom": "^29.1.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.7"
  },
  "pnpm": {
    "overrides": {
      "postcss@8": ">=8.5.23",
      "nanoid@3": "^3.3.18",
      "brace-expansion@5": ">=5.0.6",
      "undici@7": "^7.28.0",
      "@humanfs/node": ">=0.16.8"
    }
  }
}
