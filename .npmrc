# Always install devDependencies, even when NODE_ENV=production.
#
# Helm sessions run with NODE_ENV=production, which makes npm auto-set omit=dev,
# so a plain `npm install` in a fresh worktree skips eslint/vitest/vite and the
# lint/test/build gates fail with "eslint: not found". include=dev wins over any
# omit=dev (npm reconciles include over omit), so devDeps are always installed.
# Harmless for the production build, which already passes --production=false.
include=dev
