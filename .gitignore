.desloppify/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Canonical package manager is pnpm (pnpm-lock.yaml). Other PM lockfiles are
# redundant and drift in resolved versions — keep them out of the repo.
package-lock.json
bun.lock
bun.lockb

# Dev-only fixture; production updates.json lives in nginx webroot
public/updates.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Helm session attachments (screenshots etc. dropped into the worktree)
.helm-attachments/
