#!/usr/bin/env bash
# Strip unused commits[] and archive logs older than LOG_HOT_DAYS.
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
source "$SCRIPT_DIR/updates-write.sh"

UPDATES_FILE="${UPDATES_FILE:-/var/www/html/updates.json}"
ARCHIVE_FILE="${ARCHIVE_FILE:-$(dirname "$UPDATES_FILE")/updates-archive.json}"
LOG_HOT_DAYS="${LOG_HOT_DAYS:-90}"
TODAY="${TODAY:-$(TZ="Europe/Helsinki" date +%Y-%m-%d)}"
CUTOFF="$(TZ="Europe/Helsinki" date -d "${TODAY} - ${LOG_HOT_DAYS} days" +%Y-%m-%d)"

if [[ ! -f "$UPDATES_FILE" ]]; then
  echo "No updates.json at $UPDATES_FILE" >&2
  exit 1
fi

ensure_updates_lock || { echo "updates.json lock unusable — not compacted" >&2; exit 1; }
rc=0
(
  flock -w 30 9 || { echo "updates.json lock busy >30s — not compacted" >&2; exit 1; }
  if ! jq empty "$UPDATES_FILE" 2>/dev/null; then
    echo "$UPDATES_FILE is malformed JSON — refusing to compact" >&2
    exit 1
  fi
  compact_and_install
) 9>>"$UPDATES_JSON_LOCK" || rc=$?

# compact_and_install: 0 compacted, 3 degraded (logs kept in the hot file),
# anything else failed. Both non-zero cases exit non-zero so a caller notices.
case "$rc" in
  0) echo "Compacted $UPDATES_FILE (cutoff $CUTOFF, archive $ARCHIVE_FILE)" ;;
  3) echo "Compacted $UPDATES_FILE without archiving — cannot create $ARCHIVE_FILE, logs kept in the hot file" >&2
     exit 3 ;;
  *) echo "Compact failed (exit $rc) — $UPDATES_FILE not compacted" >&2
     exit "$rc" ;;
esac
