#!/usr/bin/env bash
# Regenerate updates.json's .projects array from helm's public channel list.
#
# The projects list is DERIVED, not hand-maintained. A project is public unless
# its visibility resolves private (own setting or nearest ancestor) or a feed
# embargo is in force — there is no showcase opt-in flag.
#   helm project update <name> --visibility public|private|inherit
# Heat/recency are computed client-side from entries, so this only supplies the
# per-project metadata: name, channel (mase.fi route + sidebar label), slug
# (matches entry.project), url, desc. A null url is stored as null.
#
# A project's mase.fi channel (route + sidebar label) is its helm project name —
# the url is NOT a reliable channel source (helm → cc.mase.fi, central-hub →
# db.mase.fi). So channel = slug here, unless SHOWCASE_EXTRA overrides it.
#
# SHOWCASE_EXTRA (optional) points at a JSON array of full {name,channel,slug,
# url,desc} entries for public projects that are NOT in the helm registry, or
# whose mase.fi channel must differ from their helm name (e.g. porssi ↔
# spot-price). Extras are listed first and win unique_by(.slug).
#
# Safety: if the showcase API is unreachable or returns nothing, the existing
# .projects is left untouched (never wiped).
set -euo pipefail

# Shared validate + atomic-or-in-place install of updates.json (write_updates_json).
source "$(dirname "$(readlink -f "$0")")/updates-write.sh"

UPDATES="${UPDATES_FILE:-$UPDATES_FILE_DEFAULT}"
API="${SHOWCASE_API:-http://localhost:9754/api/projects/showcase}"
EXTRA="${SHOWCASE_EXTRA:-/home/mase/Projects/mase.fi/scripts/showcase-extra.json}"

showcased="$(curl -s --max-time 60 "$API" 2>/dev/null || true)"
if ! printf '%s' "$showcased" | jq -e 'type=="array"' >/dev/null 2>&1; then
    echo "showcase API unavailable or non-array — leaving .projects unchanged" >&2
    exit 0
fi

extra='[]'
[[ -f "$EXTRA" ]] && extra="$(cat "$EXTRA" 2>/dev/null || echo '[]')"

projects="$(jq -n --argjson sc "$showcased" --argjson extra "$extra" '
  ($extra + ($sc | map(
     (.slug // (.name | ascii_downcase)) as $slug
     | {
         name: .name,
         slug: $slug,
         channel: $slug,
         url: .url,
         desc: (.tagline // "")
       })))
  | unique_by(.slug)
  | sort_by(.channel)
')"

n="$(printf '%s' "$projects" | jq 'length')"
if [[ "$n" -lt 1 ]]; then
    echo "0 public channels — leaving .projects unchanged" >&2
    exit 0
fi

# Serialize the read-modify-write against the other updates.json writers. This
# rewrites the WHOLE file with .projects swapped, so an unlocked run would clobber
# a concurrent mase-fi-update / deploy .entries append (last-writer-wins).
swap_projects() {
  jq --argjson p "$projects" '.projects = $p' "$1" > "$2"
}
with_updates_lock "$UPDATES" ".projects unchanged" swap_projects
echo "wrote $n public channels to $UPDATES"
