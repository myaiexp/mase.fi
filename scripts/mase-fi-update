#!/usr/bin/env bash
# Add one feature entry (a project's new capability) to mase.fi's updates.json
set -e

# Shared validate + atomic-or-in-place install of updates.json (write_updates_json).
source "$(dirname "$(readlink -f "$0")")/updates-write.sh"

usage() {
  echo "Usage: mase-fi-update <project> <text> [date]"
  echo ""
  echo "  project:   project name (e.g., tracker, wander) — routes to that project's channel"
  echo "  text:      update description (a new capability or visible change, never a bug fix)"
  echo "  date:      optional, YYYY-MM-DD (defaults to today, Europe/Helsinki)"
  echo ""
  echo "Writes one 'feature' entry. The old leading category argument (feature | project)"
  echo "is still accepted and ignored: every manual entry is a feature now."
  echo ""
  echo "Examples:"
  echo "  mase-fi-update helm \"Answer a blocked session's dialog from Telegram\""
  echo "  mase-fi-update wander \"Offline map tiles\" 2026-09-20"
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  usage
  exit 0
fi
# Legacy form: <feature|project> <project> <text> [date]. Both words once picked a
# category; the frontend has no use for the difference, so both now write a feature.
if { [ "${1:-}" = "feature" ] || [ "${1:-}" = "project" ]; } && [ $# -ge 3 ]; then
  shift
fi
if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  usage >&2
  exit 1
fi

PROJECT="$1"
TEXT="$2"
DATE="${3:-$(TZ="Europe/Helsinki" date +%Y-%m-%d)}"
# Env-overridable (like mase-fi-daily-summary / mase-fi-projects) so the writer can
# be exercised against a throwaway file in tests instead of the live prod webroot.
UPDATES_FILE="${UPDATES_FILE:-$UPDATES_FILE_DEFAULT}"

if [[ ! "$DATE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  # Three arguments with a non-date last one is almost always the removed category
  # argument with some other word in it (`mase-fi-update improvement helm "…"`).
  if [ $# -eq 3 ]; then
    echo "Error: the third argument must be a YYYY-MM-DD date (got '$DATE'). The category argument was removed: mase-fi-update <project> <text> [date]" >&2
  else
    echo "Error: date must be YYYY-MM-DD (got '$DATE')" >&2
  fi
  exit 1
fi
if [ "$(date -d "$DATE" +%Y-%m-%d 2>/dev/null)" != "$DATE" ]; then
  echo "Error: date is not a valid calendar day (got '$DATE')" >&2
  exit 1
fi

if [ ! -f "$UPDATES_FILE" ]; then
  echo '{"entries":[],"projects":[]}' > "$UPDATES_FILE"
fi

# Serialize against concurrent writers — a non-atomic cp once tore the file
# when deploy's commit-logger raced us. with_updates_lock owns the flock.
prepend_entry() {
  jq --arg date "$DATE" \
     --arg project "$PROJECT" \
     --arg text "$TEXT" \
     '.entries = [{date: $date, project: $project, text: $text, category: "feature"}] + .entries' \
     "$1" > "$2"
}
with_updates_lock "$UPDATES_FILE" "not added" prepend_entry

echo "Added feature entry: [$PROJECT] $TEXT ($DATE)"
