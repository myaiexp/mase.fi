#!/usr/bin/env bash
set -e

usage() {
  echo "Usage: mase-fi-update <category> <project> <text> [date]"
  echo ""
  echo "  category:  project | feature"
  echo "  project:   project name (e.g., tracker, explorer)"
  echo "  text:      update description"
  echo "  date:      optional, YYYY-MM-DD (defaults to today)"
  exit 1
}

if [ $# -lt 3 ]; then
  usage
fi

CATEGORY="$1"
PROJECT="$2"
TEXT="$3"
DATE="${4:-$(date +%Y-%m-%d)}"
UPDATES_FILE="/var/www/html/updates.json"

if [ "$CATEGORY" != "project" ] && [ "$CATEGORY" != "feature" ]; then
  echo "Error: category must be 'project' or 'feature' (got '$CATEGORY')"
  exit 1
fi

if [ "$CATEGORY" = "project" ]; then
  STICKY_LIMIT=2
else
  STICKY_LIMIT=3
fi

if [ ! -f "$UPDATES_FILE" ]; then
  echo '{"entries":[],"projects":[]}' > "$UPDATES_FILE"
fi

# Serialize against concurrent writers — deploy's commit-logger and other
# mase-fi-update calls all mutate this one shared file, and a non-atomic cp
# once let two of them interleave bytes and tear it. Shared lock path with
# helm/scripts/deploy; a one-shot validity gate fails loud on a bad file
# instead of silently echoing "Added"; unique mktemp avoids a shared temp.
(
  flock -w 30 9 || { echo "Error: updates.json lock busy >30s — not added" >&2; exit 1; }
  if ! jq empty "$UPDATES_FILE" 2>/dev/null; then
    echo "Error: $UPDATES_FILE is malformed JSON — fix it before adding entries" >&2
    exit 1
  fi
  UPD_TMP=$(mktemp)
  jq --arg date "$DATE" \
     --arg project "$PROJECT" \
     --arg text "$TEXT" \
     --arg category "$CATEGORY" \
     --argjson limit "$STICKY_LIMIT" \
     '
     .entries = [{date: $date, project: $project, text: $text, category: $category, sticky: true}] + .entries
     | .entries = (
         [ .entries | to_entries[] | select(.value.category == $category and .value.sticky == true) | .key ] as $sticky_indices
         | if ($sticky_indices | length) > $limit then
             ($sticky_indices[$limit:]) as $demote
             | .entries | to_entries | map(
                 if (.key | IN($demote[])) then .value.sticky = false | .value else .value end
               )
           else
             .entries
           end
       )
     ' \
     "$UPDATES_FILE" > "$UPD_TMP" \
  && cp "$UPD_TMP" "$UPDATES_FILE"
  rm -f "$UPD_TMP"
) 9>/tmp/mase-updates-json.lock

echo "Added $CATEGORY entry: [$PROJECT] $TEXT ($DATE)"
