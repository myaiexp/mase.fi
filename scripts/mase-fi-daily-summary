#!/usr/bin/env bash
# Generate daily summary entries from today's log entries in updates.json
set -euo pipefail

UPDATES_FILE="${UPDATES_FILE:-/var/www/html/updates.json}"
TODAY=$(TZ="Europe/Helsinki" date +%Y-%m-%d)
DELEGATE_URL="${DELEGATE_URL:-http://localhost:9754/api/delegate}"
NTFY_URL="${NTFY_URL:-https://ntfy.mase.fi/kelo}"
HELM_ENV="${HELM_ENV:-/home/mase/Projects/helm/.env}"

# Best-effort ntfy push, isolated in a subshell so `set +e` and any failing
# command here can't propagate into the script's `set -e`. Token from $NTFY_TOKEN
# or helm's .env — no systemd EnvironmentFile needed, so this observability lives
# entirely in the versioned script (mirrors helm's refuse-dirty-tree helper).
ntfy_send() (
  set +e
  title="$1"; body="$2"
  token="${NTFY_TOKEN:-}"
  if [ -z "$token" ] && [ -f "$HELM_ENV" ]; then
    token=$(grep -E '^NTFY_TOKEN=' "$HELM_ENV" 2>/dev/null | head -1 | cut -d= -f2-)
  fi
  [ -n "$token" ] || exit 0
  curl -fsS -m 10 \
    -H "Authorization: Bearer $token" \
    -H "Title: $title" \
    -d "$body" \
    "$NTFY_URL" >/dev/null 2>&1 || true
)

# `set -euo pipefail` aborts before any in-script alert, so a hard failure (jq
# error, delegate curl breaking a pipe, mid-run I/O) would degrade the homepage
# silently. Fire one alert on any non-zero exit; the intentional skip paths below
# all `exit 0`, so a normal no-op run stays quiet.
on_exit() {
  local rc=$?
  if [[ $rc -ne 0 ]]; then
    ntfy_send "mase.fi daily-summary FAILED (exit $rc)" \
      "${TODAY}: daily-summary aborted (exit $rc) — check: journalctl --user -u mase-fi-daily-summary"
  fi
}
trap on_exit EXIT

if [[ ! -f "$UPDATES_FILE" ]]; then
    echo "No updates.json found"
    exit 0
fi

# Skip if daily entries already exist for today (idempotency)
DAILY_EXISTS=$(jq --arg date "$TODAY" '[.entries[] | select(.category == "daily" and .date == $date)] | length' "$UPDATES_FILE")
if [[ "$DAILY_EXISTS" -gt 0 ]]; then
    echo "Daily entries already exist for $TODAY — skipping"
    exit 0
fi

# Count today's log entries
LOG_COUNT=$(jq --arg date "$TODAY" '[.entries[] | select(.category == "log" and .date == $date)] | length' "$UPDATES_FILE")

if [[ "$LOG_COUNT" -eq 0 ]]; then
    echo "No log entries for $TODAY — skipping"
    exit 0
fi

# Salvage the real highlight list from a small model's raw reply.
# Hermes routinely leaks preamble and wrapper junk around the actual answer —
# XML/markdown tags (`<?xml…`, `<warning>`, `<md>`), colon lead-ins
# ("Here are the highlights:"), refusals ("I don't have…"), and stray words on
# their own line (a bare " downturn" before the list). `head -1` stored that junk
# verbatim onto the homepage. Instead: drop the junk lines, then among survivors
# pick the one that most looks like the requested comma-separated list (most
# commas wins; first line otherwise). Emits one line, or nothing if all dropped.
sanitize_output() {
    awk '
    {
        line = $0
        gsub(/\r/, "", line)
        sub(/^[[:space:]]+/, "", line); sub(/[[:space:]]+$/, "", line)
        # strip a single pair of wrapping quotes/backticks around the whole line
        if (line ~ /^".*"$/ || line ~ /^`.*`$/ || line ~ /^'\''.*'\''$/) {
            line = substr(line, 2, length(line) - 2)
            sub(/^[[:space:]]+/, "", line); sub(/[[:space:]]+$/, "", line)
        }
        if (line == "")            next   # blank
        if (line ~ /^```/)         next   # code fence
        if (line ~ /^[][{}]/)      next   # JSON / tool-call structure ({ } [ ] — open or close)
        if (line ~ /^"?[A-Za-z_][A-Za-z0-9_-]*"?[[:space:]]*:[[:space:]]*["{[]/) next  # JSON key line ("command": "echo…, "args": {)
        if (line ~ /[<>]/)         next   # any XML/HTML tag (<?xml, <warning>, <md>, </…>)
        if (line ~ /:[[:space:]]*$/) next # lead-in ending in a colon
        low = tolower(line)
        if (low ~ /^(i (do not|don.?t|can.?t|cannot|am unable|will)|i.?m (unable|sorry)|as an ai|here (are|is|.?s)|sure[,:]|note:|disclaimer|output:|summary:)/) next
        commas = gsub(/,/, ",", line)     # gsub returns the match count
        if (first == "") first = line
        if (commas > bestn) { bestn = commas; best = line }
    }
    END { if (best != "") print best; else if (first != "") print first }
    '
}

# A highlight list is short by design; clamp a rambling reply to the last whole
# item under ~110 chars rather than dumping an over-long line on the homepage.
truncate_summary() {
    local s="$1" max=110
    [[ ${#s} -le $max ]] && { printf '%s' "$s"; return; }
    local head="${s:0:$max}"
    if [[ "$head" == *,* ]]; then printf '%s' "${head%,*}"; else printf '%s…' "${head% *}"; fi
}

# Generate AI summary from a list of commit messages via helm delegate (#954).
# Routes through localhost helm delegate (Nous Hermes) instead of a direct
# Anthropic OAuth call — standardizes external automation on the dispatch
# primitive and drops the ~/.claude OAuth-token dependency.
# Falls back to "project: N commits" if helm/delegate is unavailable or the
# reply survives sanitization as nothing usable.
generate_summary() {
    local project="$1"
    local commits_text="$2"
    local count="$3"
    local fallback="${project}: ${count} commits"

    # Group-into-themes prompt (chosen over per-commit enumeration and prose after
    # a live dry run on Hermes-4 across real project-days): synthesizes related
    # commits into a few themes instead of de-verbing every subject, and the
    # few-shot keeps the model out of "tool call" mode that the old terse prompt
    # tripped. Output stays terminal-dense (lowercase, comma-separated).
    local prompt
    prompt="You are writing a one-line daily changelog for a software project from its git commits. Group the related commits into 3-5 short THEMES (not one-per-commit). Synthesize; drop trivial noise like version bumps and lint unless that is all there is. Output ONLY a terse, lowercase, comma-separated list on a single line, max 90 characters. No project name, no preamble, no tags, no quotes.
Example commits:
feat(auth): add OAuth login
fix(auth): handle token refresh
chore(deps): bump axios
test(auth): cover login flow
Example output: oauth login + token refresh, dep bumps, auth tests

Commits:
${commits_text}"

    local payload
    payload=$(jq -n --arg prompt "$prompt" '{prompt: $prompt, providerId: "nous"}')

    local response
    response=$(curl -s --max-time 60 \
        -H "content-type: application/json" \
        -d "$payload" \
        "$DELEGATE_URL" 2>/dev/null)

    # `.output` carries the model text. sanitize_output strips the model's
    # preamble/tag/refusal noise and returns the line that reads as the list.
    local summary
    summary=$(echo "$response" | jq -r '.output // empty' 2>/dev/null | sanitize_output)

    if [[ -n "$summary" ]]; then
        truncate_summary "$summary"; echo
    else
        echo "$fallback"
    fi
}

# Group log entries by project, extract per-project data
jq --arg date "$TODAY" '
  [.entries[] | select(.category == "log" and .date == $date)] | group_by(.project) |
  map({project: .[0].project, commits: [.[].text]})
' "$UPDATES_FILE" > /tmp/daily_groups.json

# Build daily entries with AI summaries
echo '[]' > /tmp/daily_entries.json

FALLBACK_COUNT=0   # projects where the delegate produced nothing usable
DELEGATE_COUNT=0   # projects that actually went through the delegate (multi-commit)

for i in $(jq -r 'range(length)' /tmp/daily_groups.json); do
    project=$(jq -r ".[$i].project" /tmp/daily_groups.json)
    count=$(jq -r ".[$i].commits | length" /tmp/daily_groups.json)
    commits_json=$(jq -c ".[$i].commits" /tmp/daily_groups.json)

    if [[ "$count" -eq 1 ]]; then
        summary=$(jq -r ".[$i].commits[0]" /tmp/daily_groups.json)
    else
        commits_text=$(jq -r ".[$i].commits[]" /tmp/daily_groups.json)
        summary=$(generate_summary "$project" "$commits_text" "$count")
        DELEGATE_COUNT=$((DELEGATE_COUNT + 1))
        # generate_summary echoes exactly this string when the delegate is down or
        # its reply sanitizes to nothing — the silent-degradation signal. The model
        # prompt forbids the "project: N" shape, so a real summary can't collide.
        [[ "$summary" == "${project}: ${count} commits" ]] && FALLBACK_COUNT=$((FALLBACK_COUNT + 1))
    fi

    jq --arg date "$TODAY" --arg project "$project" --arg summary "$summary" \
       --argjson commits "$commits_json" \
       '. + [{date: $date, category: "daily", project: $project, summary: $summary, commits: $commits}]' \
       /tmp/daily_entries.json > /tmp/daily_entries.json.tmp \
    && mv /tmp/daily_entries.json.tmp /tmp/daily_entries.json
done

rm -f /tmp/daily_groups.json

# Prepend daily entries to the entries array
jq --slurpfile daily /tmp/daily_entries.json '
  .entries = ($daily[0] + .entries)
' "$UPDATES_FILE" > /tmp/updates.json.tmp \
&& cp /tmp/updates.json.tmp "$UPDATES_FILE" \
&& rm /tmp/updates.json.tmp /tmp/daily_entries.json

DAILY_COUNT=$(jq --arg date "$TODAY" '[.entries[] | select(.category == "daily" and .date == $date)] | length' "$UPDATES_FILE")
echo "Created $DAILY_COUNT daily summary entries for $TODAY"

# One consolidated alert if any delegate summary silently degraded to a commit
# count — rather than per-project spam. The run still succeeded (fallback text is
# valid), so this is informational, not a failure.
if [[ "$FALLBACK_COUNT" -gt 0 ]]; then
    ntfy_send "mase.fi daily-summary degraded" \
        "${TODAY}: ${FALLBACK_COUNT}/${DELEGATE_COUNT} project summaries fell back to commit counts — helm delegate unavailable or returned nothing usable"
    echo "Degraded run: ${FALLBACK_COUNT}/${DELEGATE_COUNT} projects fell back — ntfy sent"
fi
